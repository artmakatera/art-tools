{
  "name": "@art-tools/react-gantt",
  "version": "0.0.0",
  "description": "Composable, virtualized Gantt chart for React — dependencies, working-time calendars, undo/redo, and slot-based theming.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "project-management",
    "react",
    "scheduling",
    "timeline",
    "typescript",
    "virtualized"
  ],
  "homepage": "https://github.com/artmakatera/react-gantt-edge#readme",
  "bugs": {
    "url": "https://github.com/artmakatera/react-gantt-edge/issues"
  },
  "license": "MIT",
  "author": "Artem Makatera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artmakatera/react-gantt-edge.git",
    "directory": "packages/react-gantt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "style": "./dist/style.css",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "vite build",
    "dev": "vite build --watch",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@am/config-typescript": "workspace:*",
    "@am/oxlint-config": "workspace:*",
    "@microsoft/api-extractor": "^7.59.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
