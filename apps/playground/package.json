{
  "name": "@am/playground",
  "version": "0.0.0",
  "private": true,
  "description": "Local experimentation + performance benchmarks for @am/react-gantt",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
