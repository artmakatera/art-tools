  "devDependencies": {
    "@am/config-typescript": "workspace:*",
    "@am/oxlint-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
